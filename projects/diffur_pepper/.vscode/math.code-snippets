{
  "Отдельная формула": {
    "scope": "latex",
    "prefix": "mm",
    "body": [
      "\\[",
      "  $0",
      "\\]"
    ],
    "description": "Формула без номера"
  },
  "Формула с номером": {
    "scope": "latex",
    "prefix": "eqn",
    "body": [
      "\\begin{equation}",
      "  $0",
      "\\end{equation}"
    ],
    "description": "Нумерованная формула"
  },
  "Выровненные формулы": {
    "scope": "latex",
    "prefix": "aln",
    "body": [
      "\\begin{align*}",
      "  ${1:a} &= ${2:b} \\\\",
      "  $0",
      "\\end{align*}"
    ],
    "description": "Несколько строк формул"
  },
  "Дробь": {
    "scope": "latex",
    "prefix": "ff",
    "body": "\\frac{${1:числитель}}{${2:знаменатель}}$0"
  },
  "Теорема": {
    "scope": "latex",
    "prefix": "thm",
    "body": [
      "\\thm{${1:Название}}{",
      "  ${2:Формулировка}",
      "}{",
      "  ${3:Доказательство}",
      "}",
      "$0"
    ],
    "description": "Теорема с названием, формулировкой и доказательством"
  },
  "Короткое определение": {
    "scope": "latex",
    "prefix": "def",
    "body": "\\Def{${1:текст}}$0",
    "description": "Опр. (жирным) и текст определения"
  },
  "Лемма": {
    "scope": "latex",
    "prefix": "lem",
    "body": [
      "\\lem{${1:Название}}{",
      "  ${2:Формулировка}",
      "}{",
      "  ${3:Доказательство}",
      "}",
      "$0"
    ],
    "description": "Лемма с названием, формулировкой и доказательством"
  },
  "Утверждение": {
    "scope": "latex",
    "prefix": "utv",
    "body": [
      "\\utv{${1:Название}}{",
      "  ${2:Формулировка}",
      "}{",
      "  ${3:Доказательство}",
      "}",
      "$0"
    ],
    "description": "Утверждение с названием, формулировкой и доказательством"
  }
}
